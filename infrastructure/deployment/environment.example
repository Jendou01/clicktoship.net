# Not a usable secret file; generate independent secrets outside the checkout.
APP_NAME=ClickToShip
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://staging.example.test
APP_ALLOWED_HOSTS=staging.example.test
TRUSTED_PROXIES=172.30.71.10
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clicktoship_staging
DB_USERNAME=cts_runtime
DB_PASSWORD=
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PREFIX=cts_staging_
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=cts_staging_session
SANCTUM_STATEFUL_DOMAINS=staging.example.test
MAIL_MAILER=smtp
MAIL_HOST=REQUIRES_PRIVATE_APPROVED_SMTP
MAIL_PORT=587
MAIL_FROM_ADDRESS=noreply@example.test
LOG_CHANNEL=stderr
QUEUE_FAILED_DRIVER=database-uuids
